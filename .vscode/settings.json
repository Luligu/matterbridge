// VS Code settings native v.1.0.14
{
  "npm.packageManager": "npm",
  // Actually controls the runner used by "Run Script"/tasks; packageManager alone is not enough.
  "npm.scriptRunner": "npm",
  "eslint.enable": false,
  "prettier.enable": false,
  "oxc.enable": true,
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.promptToUseWorkspaceVersion": false,
  "terminal.integrated.scrollback": 5000,
  "editor.tabSize": 2,
  "editor.rulers": [180],
  "editor.formatOnSave": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[markdown]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.format.oxc": "always",
    "source.fixAll.oxc": "always"
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/build/**": true,
    "**/.cache/**": true,
    "**/coverage/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.cache": true,
    "**/coverage": true
  },
  "git.autofetch": true,
  "git.autoRepositoryDetection": false,
  // VS Code's Copilot Chat extension settings
  "chat.useCustomizationsInParentRepositories": true, // Default false.
  "chat.useAgentsMdFile": true, // Load AGENTS.md at the workspace root as always-on instructions.
  "chat.useNestedAgentsMdFiles": true, // Also load nested AGENTS.md files in subfolders. Experimental.
  "github.copilot.chat.commitMessageGeneration.instructions": [{ "file": ".github/commit-message-instructions.md" }], // Conventional Commits for the Source Control "Generate Commit Message" button.
  "chat.tools.terminal.autoApprove": {
    // Denied: raw tool invocations must go through the npm scripts (AGENTS.md hard rule).
    "npx tsc": false,
    "npx oxlint": false,
    "npx oxfmt": false,
    "npx vitest": false,
    "tsc": false,
    "oxlint": false,
    "oxfmt": false,
    "vitest": false,
    // Denied: git mutations and history rewrites must be run manually outside the agent.
    "git pull": false,
    "git merge": false,
    "git push": false,
    "git rebase": false,
    "git commit": false,
    "git reset": false,
    "git filter-branch": false,
    "git branch -D": false,
    "git branch -d": false,
    "git tag -d": false,
    "git stash": false,
    "git reflog expire": false,
    "git reflog delete": false,
    // Denied: applies automatic fixes, so it needs an explicit confirmation.
    "npm run lint:fix": false,
    // Ask: dependency changes need an explicit confirmation.
    "npm install": false,
    "npm i": false,
    "npm uninstall": false,
    "bun install": false,
    "bun i": false,
    "bun uninstall": false,
    "bun add": false,
    "bun remove": false,
    // Ask: mb-run rewrites vendored files and package.json.
    "mb-run": false,
    "npx mb-run": false,
    "bunx mb-run": false,
    // Ask: external network fetches and container runs.
    "curl": false,
    "Invoke-WebRequest": false,
    "docker pull": false,
    "docker run": false,
    // Approved: validation scripts.
    "npm run build": true,
    "npm run typecheck": true,
    "npm run lint": true,
    "npm run format": true,
    "npm run format:check": true,
    "npm run test": true,
    "npm run test:watch": true,
    "npm run test:verbose": true,
    "npm run test:coverage": true,
    "npm run update-htmls": true,
    "bun test": true,
    // Approved: read-only shell utilities.
    "cat": true,
    "ls": true,
    "head": true,
    "tail": true,
    "find": true,
    "grep": true,
    "echo": true,
    "cd": true,
    // Approved: read-only git.
    "git status": true,
    "/^git (?:--no-pager )?diff(?: --(?:check|stat))?$/": true,
    "git log": true,
    "git show": true,
    "git branch -vv": true,
    "git ls-files": true
  }
}

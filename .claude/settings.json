{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Claude settings v.1.0.12",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["npm run test*", "npm run test:bun*", "bun run test*", "bun run test:bun*"],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": ["api.github.com", "github.com", "registry.npmjs.org", "matterbridge.io", "www.rfc-editor.org", "www.ietf.org"]
    }
  },
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Bash(git -C:*)",
      "Bash(git -c:*)",
      "Bash(git --git-dir:*)",
      "Bash(git --work-tree:*)",
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git filter-branch:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git tag -d:*)",
      "Bash(git stash:*)",
      "Bash(git reflog expire:*)",
      "Bash(git reflog delete:*)",
      "Bash(bun run lint:fix:*)",
      "Bash(npm run lint:fix:*)",
      "Bash(npx vitest:*)",
      "Bash(bunx vitest:*)",
      "Bash(vitest:*)",
      "Bash(bun test:*)",
      "Bash(npx oxfmt:*)",
      "Bash(bunx oxfmt:*)",
      "Bash(oxfmt:*)",
      "Bash(npx oxlint:*)",
      "Bash(bunx oxlint:*)",
      "Bash(oxlint:*)",
      "Bash(npx tsc:*)",
      "Bash(bunx tsc:*)",
      "Bash(tsc:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git clean:*)",
      "Bash(git revert:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(bun install:*)",
      "Bash(bun i:*)",
      "Bash(bun uninstall:*)",
      "Bash(bun add:*)",
      "Bash(bun remove:*)",
      "Bash(mb-run:*)",
      "Bash(npx mb-run:*)",
      "Bash(bunx mb-run:*)",
      "Bash(curl:*)",
      "PowerShell(Invoke-WebRequest:*)",
      "Bash(docker pull:*)",
      "Bash(docker run:*)"
    ],
    "allow": [
      "Read",
      "Bash(npm run typecheck:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run update-htmls:*)",
      "Bash(bun run typecheck:*)",
      "Bash(bun run build:*)",
      "Bash(bun run test:*)",
      "Bash(bun run lint:*)",
      "Bash(bun run format:*)",
      "Bash(grep:*)",
      "Bash(cd:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(head:*)",
      "Bash(cat:*)",
      "Bash(ls:*)"
    ]
  }
}

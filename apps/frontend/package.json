{
  "name": "@matterbridge/frontend",
  "version": "3.6.6",
  "description": "Matterbridge frontend application",
  "author": "https://github.com/Luligu",
  "license": "Apache-2.0",
  "homepage": "https://matterbridge.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luligu/matterbridge.git",
    "directory": "apps/frontend"
  },
  "bugs": {
    "url": "https://github.com/Luligu/matterbridge/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/luligugithub"
  },
  "keywords": [
    "matterbridge",
    "homebridge",
    "bridge",
    "plugin",
    "frontend",
    "matter.js",
    "matter-node.js",
    "matter",
    "matterprotocol",
    "iot",
    "smarthome",
    "connectedthings",
    "hap",
    "homekit",
    "siri",
    "google-home",
    "alexa",
    "homeassistant",
    "smartthings",
    "ewelink"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "files": [
    "build",
    "package.json",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:debug": "vite build --mode debug",
    "watch": "vite build --watch",
    "preview": "vite preview",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest --reporter verbose --reporter junit",
    "test:verbose": "vitest run --reporter verbose --reporter junit",
    "test:coverage": "vitest run --reporter verbose --reporter junit --coverage",
    "clean": "node ../../scripts/clean.mjs",
    "cleanBuild": "npm run clean && npm run build",
    "deepClean": "node ../../scripts/deep-clean.mjs",
    "reset": "npm run deepClean && npm run softReset",
    "softReset": "npm install --no-fund --no-audit && npm prune --no-fund --no-audit && npm run build && npm run typecheck",
    "softReset:bun": "bun install && bun prune && bun run build && bun run typecheck",
    "checkDependencies": "npx --yes --package npm-check-updates ncu",
    "updateDependencies": "npx --yes --package npm-check-updates ncu -u && npm run softReset",
    "runMeBeforePublish": "npm run build && npm run typecheck && npm run format && npm run lint && npm run test:coverage",
    "prepublishOnly": "npm run cleanBuild && npm pkg delete devDependencies scripts && node ../../scripts/prepublish-clean.mjs && npm install --no-fund --no-audit --omit=dev && npm shrinkwrap --omit=dev"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mdi/js": "7.4.47",
    "@mdi/react": "1.6.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@rjsf/core": "6.11.0",
    "@rjsf/utils": "6.11.0",
    "@rjsf/validator-ajv8": "6.11.0",
    "notistack": "3.0.2",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "globals": "17.13.0",
    "vite": "8.3.4"
  }
}

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "removeComments": true,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "package.json"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts"],
  "references": [{ "path": "./packages/core/tsconfig.build.production.json" }]
}

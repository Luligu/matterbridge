# Codex rules v.1.0.6

# Git mutations
prefix_rule(pattern = ["git", "pull"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "merge"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "push"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "rebase"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "commit"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "reset"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "filter-branch"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "branch", "-D"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "branch", "-d"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "tag", "-d"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "reflog", "expire"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "reflog", "delete"], decision = "forbidden", justification = "This command must be run manually outside Codex.")
prefix_rule(pattern = ["git", "stash"], decision = "forbidden", justification = "This command must be run manually outside Codex.")

# Raw tool invocations: always use the matching npm script (AGENTS.md hard rule)
prefix_rule(pattern = ["npx", "tsc"], decision = "forbidden", justification = "Use the matching npm script instead.")
prefix_rule(pattern = ["npx", "oxlint"], decision = "forbidden", justification = "Use the matching npm script instead.")
prefix_rule(pattern = ["npx", "oxfmt"], decision = "forbidden", justification = "Use the matching npm script instead.")
prefix_rule(pattern = ["npx", "vitest"], decision = "forbidden", justification = "Use the matching npm script instead.")
prefix_rule(pattern = ["tsc"], decision = "forbidden", justification = "Use the matching npm script instead.")
prefix_rule(pattern = ["oxlint"], decision = "forbidden", justification = "Use the matching npm script instead.")
prefix_rule(pattern = ["oxfmt"], decision = "forbidden", justification = "Use the matching npm script instead.")
prefix_rule(pattern = ["vitest"], decision = "forbidden", justification = "Use the matching npm script instead.")

# Dependency installs
prefix_rule(pattern = ["npm", "install"], decision = "prompt", justification = "Ask before installing dependencies.")
prefix_rule(pattern = ["npm", "i"], decision = "prompt", justification = "Ask before installing dependencies.")
prefix_rule(pattern = ["npm", "uninstall"], decision = "prompt", justification = "Ask before uninstalling dependencies.")
prefix_rule(pattern = ["bun", "install"], decision = "prompt", justification = "Ask before installing dependencies.")
prefix_rule(pattern = ["bun", "i"], decision = "prompt", justification = "Ask before installing dependencies.")
prefix_rule(pattern = ["bun", "uninstall"], decision = "prompt", justification = "Ask before uninstalling dependencies.")
prefix_rule(pattern = ["bun", "add"], decision = "prompt", justification = "Ask before installing dependencies.")
prefix_rule(pattern = ["bun", "remove"], decision = "prompt", justification = "Ask before uninstalling dependencies.")

# Validation scripts
prefix_rule(pattern = ["npm", "run", "typecheck"], decision = "allow")
prefix_rule(pattern = ["npm", "run", "build"], decision = "allow")
prefix_rule(pattern = ["npm", "run", "test"], decision = "allow")
prefix_rule(pattern = ["npm", "run", "test:watch"], decision = "allow")
prefix_rule(pattern = ["npm", "run", "test:verbose"], decision = "allow")
prefix_rule(pattern = ["npm", "run", "test:coverage"], decision = "allow")
prefix_rule(pattern = ["npm", "run", "lint"], decision = "allow")
prefix_rule(pattern = ["npm", "run", "lint:fix"], decision = "forbidden", justification = "Automatic lint fixes must be run manually outside Codex.")
prefix_rule(pattern = ["npm", "run", "format"], decision = "allow")
prefix_rule(pattern = ["npm", "run", "format:check"], decision = "allow")
prefix_rule(pattern = ["npm", "run", "update-htmls"], decision = "allow")
prefix_rule(pattern = ["bun", "test"], decision = "allow")

# Shell utilities
prefix_rule(pattern = ["cat"], decision = "allow")
prefix_rule(pattern = ["ls"], decision = "allow")
prefix_rule(pattern = ["head"], decision = "allow")
prefix_rule(pattern = ["tail"], decision = "allow")
prefix_rule(pattern = ["grep"], decision = "allow")
prefix_rule(pattern = ["echo"], decision = "allow")
prefix_rule(pattern = ["cd"], decision = "allow")

# External network and containers
prefix_rule(pattern = ["curl"], decision = "prompt", justification = "Ask before external network fetches.")
prefix_rule(pattern = ["Invoke-WebRequest"], decision = "prompt", justification = "Ask before external network fetches.")
prefix_rule(pattern = ["docker", "pull"], decision = "prompt", justification = "Ask before downloading Docker images.")
prefix_rule(pattern = ["docker", "run"], decision = "prompt", justification = "Ask before running Docker containers.")

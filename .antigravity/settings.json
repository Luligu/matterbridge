{
  "_comment": "Antigravity settings v.1.0.5",
  "sandboxing": {
    "workspaceOnly": true,
    "subagentIsolation": "branch",
    "networkAccess": "restricted",
    "browserSandbox": true
  },
  "permissions": {
    "deny": [
      "read_file(.env)",
      "read_file(.env.*)",
      "read_file(**/.env)",
      "read_file(**/.env.*)",
      "read_file(**/secrets/**)",
      "command(git pull)",
      "command(git merge)",
      "command(git push)",
      "command(git rebase)",
      "command(git commit)",
      "command(git reset)",
      "command(git filter-branch)",
      "command(git branch -D)",
      "command(git branch -d)",
      "command(git tag -d)",
      "command(git stash)",
      "command(git reflog expire)",
      "command(git reflog delete)",
      "command(npx tsc)",
      "command(npx oxlint)",
      "command(npx oxfmt)",
      "command(npx vitest)",
      "command(tsc)",
      "command(oxlint)",
      "command(oxfmt)",
      "command(vitest)",
      "command(npm run lint:fix)"
    ],
    "ask": [
      "command(npm install)",
      "command(npm i)",
      "command(npm uninstall)",
      "command(bun install)",
      "command(bun i)",
      "command(bun uninstall)",
      "command(bun add)",
      "command(bun remove)",
      "command(mb-run)",
      "command(npx mb-run)",
      "command(bunx mb-run)",
      "command(curl)",
      "command(Invoke-WebRequest)",
      "command(docker pull)",
      "command(docker run)"
    ],
    "allow": [
      "read_file(*)",
      "command(npm run typecheck)",
      "command(npm run build)",
      "command(npm run test)",
      "command(npm run test:watch)",
      "command(npm run test:verbose)",
      "command(npm run test:coverage)",
      "command(npm run lint)",
      "command(npm run format)",
      "command(npm run format:check)",
      "command(npm run update-htmls)",
      "command(bun test)",
      "command(cat)",
      "command(ls)",
      "command(head)",
      "command(tail)",
      "command(find)",
      "command(grep)",
      "command(echo)",
      "command(cd)",
      "command(git status)",
      "command(git diff)",
      "command(git diff --check)",
      "command(git diff --stat)",
      "command(git log)",
      "command(git show)",
      "command(git branch -vv)",
      "command(git ls-files)"
    ]
  }
}

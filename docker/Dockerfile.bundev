# ─────────────── BUILD STAGE ───────────────
FROM oven/bun:slim AS builder

# 🛠️ Set noninteractive frontend
ENV DEBIAN_FRONTEND=noninteractive

# Install git to clone the repositories
RUN apt-get update && apt-get install -y --no-install-recommends git

WORKDIR /matterbridge
COPY . .
RUN \
  bun install && \
  bun --bun scripts/version.mjs git && \
  bun --bun scripts/sync-workspaces.mjs --scope @matterbridge && \
  bun run buildProduction && \
  cd apps/frontend && bun install && bun run build && rm -rf node_modules public src vitest package-lock.json && cd ../.. && \
  bun link && \
  bun --workspaces --include-workspace-root pm pkg delete devDependencies scripts && \
  rm -rf .agents .cache .claude .codex .devcontainer .git .github .vscode docker docs node_modules reflector screenshots scripts systemd package-lock.json npm-shrinkwrap.json && \
  bun install --omit=dev

WORKDIR /matterbridge-zigbee2mqtt
# ADD https://api.github.com/repos/Luligu/matterbridge-zigbee2mqtt/commits/dev /tmp/matterbridge-zigbee2mqtt-dev-head.json
RUN GIT_SSL_NO_VERIFY=true git clone --depth 1 --single-branch --no-tags -b dev https://github.com/Luligu/matterbridge-zigbee2mqtt.git . && \
  SHA7=$(git rev-parse --short=7 HEAD) && \
  BASE_VERSION=$(bun -e "console.log(require('./package.json').version.split('-')[0])") && \
  bun pm pkg set version="${BASE_VERSION}-git-${SHA7}" && \
  bun install && bun link matterbridge && bun run buildProduction && rm -rf node_modules && bun install --omit=dev && \
  rm -rf .agents .cache .claude .codex .devcontainer .git .github .vscode docs screenshots scripts src test vitest buntest .gitattributes .gitignore .localignore .ox*.json tsconfig*.json bun.lock package-lock.json npm-shrinkwrap.json

WORKDIR /matterbridge-somfy-tahoma
# ADD https://api.github.com/repos/Luligu/matterbridge-somfy-tahoma/commits/dev /tmp/matterbridge-somfy-tahoma-dev-head.json

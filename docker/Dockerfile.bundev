# ─────────────── RUNTIME STAGE ───────────────
FROM oven/bun:slim AS release

# 🛠️ Set noninteractive frontend
ENV DEBIAN_FRONTEND=noninteractive

# ---- Build arguments injected by CI ----
ARG VERSION
ARG VCS_REF
ARG BUILD_DATE

# ---- OCI standard labels (https://opencontainers.org/) ----
LABEL org.opencontainers.image.title="matterbridge" \
  org.opencontainers.image.description="Matterbridge plugin manager for Matter" \
  org.opencontainers.image.version=$VERSION \
  org.opencontainers.image.revision=$VCS_REF \
  org.opencontainers.image.source="git+https://github.com/Luligu/matterbridge.git" \
  org.opencontainers.image.url="https://matterbridge.io" \
  org.opencontainers.image.documentation="https://matterbridge.io/README.html" \
  org.opencontainers.image.licenses="Apache-2.0" \
  org.opencontainers.image.authors="Luligu <https://github.com/Luligu>" \
  org.opencontainers.image.created=$BUILD_DATE

WORKDIR /matterbridge
COPY ./.dockerbuild.json ./

WORKDIR /root/.bun/install/global/node_modules
COPY --from=builder /matterbridge/ ./matterbridge/
COPY --from=builder /matterbridge-zigbee2mqtt/ ./matterbridge-zigbee2mqtt/
COPY --from=builder /matterbridge-somfy-tahoma/ ./matterbridge-somfy-tahoma/
COPY --from=builder /matterbridge-shelly/ ./matterbridge-shelly/
COPY --from=builder /matterbridge-hass/ ./matterbridge-hass/
COPY --from=builder /matterbridge-webhooks/ ./matterbridge-webhooks/
COPY --from=builder /matterbridge-security/ ./matterbridge-security/
COPY --from=builder /matterbridge-irobot/ ./matterbridge-irobot/
COPY --from=builder /matterbridge-mqtt/ ./matterbridge-mqtt/
COPY --from=builder /matterbridge-test/ ./matterbridge-test/
COPY --from=builder /matterbridge-example-accessory-platform/ ./matterbridge-example-accessory-platform/
COPY --from=builder /matterbridge-example-dynamic-platform/ ./matterbridge-example-dynamic-platform/
COPY --from=builder /matterbridge-example-camera/ ./matterbridge-example-camera/
COPY --from=builder /matterbridge-eve-door/ ./matterbridge-eve-door/
COPY --from=builder /matterbridge-eve-motion/ ./matterbridge-eve-motion/
COPY --from=builder /matterbridge-eve-energy/ ./matterbridge-eve-energy/
COPY --from=builder /matterbridge-eve-room/ ./matterbridge-eve-room/
COPY --from=builder /matterbridge-eve-weather/ ./matterbridge-eve-weather/

RUN \
  GLOBAL_NODE_MODULES=/root/.bun/install/global/node_modules && \
  GLOBAL_BIN="${BUN_INSTALL_BIN:-/usr/local/bin}" && \
  mkdir -p "$GLOBAL_BIN" && \
  bun -e "const pkg = require('$GLOBAL_NODE_MODULES/matterbridge/package.json'); for (const [name, target] of Object.entries(pkg.bin || {})) console.log(name + ' ' + target);" | while read -r NAME TARGET; do \
  chmod +x "$GLOBAL_NODE_MODULES/matterbridge/$TARGET" && \
  ln -sf "$GLOBAL_NODE_MODULES/matterbridge/$TARGET" "$GLOBAL_BIN/$NAME"; \
  done && \
  find "$GLOBAL_NODE_MODULES" -maxdepth 4 -type d -name ".github" -exec rm -rf {} + && \
  find "$GLOBAL_NODE_MODULES" -maxdepth 4 -type d -name ".vscode" -exec rm -rf {} + && \
  find "$GLOBAL_NODE_MODULES" -maxdepth 4 -type d -name "docs" -exec rm -rf {} + && \
  find "$GLOBAL_NODE_MODULES" -type f \( -name "*.ts" -o -name "*.js.map" -o -name "*.d.ts" -o -name "*.d.ts.map" -o -name "LICENSE" -o -name "LICENSE.txt" -o -name "*.md" \) -delete && \
  if [ -d "$GLOBAL_NODE_MODULES/matterbridge/node_modules/@matter" ]; then \
  find "$GLOBAL_NODE_MODULES/matterbridge/node_modules/@matter" -type d -name "src" -exec rm -rf {} + && \
  find "$GLOBAL_NODE_MODULES/matterbridge/node_modules/@matter" -type d -name "cjs" -exec rm -rf {} +; \
  fi

WORKDIR /matterbridge

# Add Docker HEALTHCHECK
HEALTHCHECK --interval=60s --timeout=10s --start-period=60s --retries=5 \
  CMD mb_health

# Copy and execute the entrypoint script
COPY ./docker/entrypoint.bundev.sh ./
RUN chmod +x ./entrypoint.bundev.sh
ENTRYPOINT ["./entrypoint.bundev.sh"]
CMD ["bun", "--bun", "/usr/local/bin/matterbridge", "--docker"]
# ─────────────── END ───────────────

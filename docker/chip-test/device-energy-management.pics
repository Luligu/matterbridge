# To run tests on DeviceEnergyManagement --PICS is required
# Matches createDefaultDeviceEnergyManagementClusterServer() on CHIP DeviceEnergyManagement endpoint 207
PICS_SDK_CI_ONLY=1
DEM.S=1
DEM.S.F00=1 # PowerAdjustment
DEM.S.F01=1 # PowerForecastReporting
DEM.S.F02=0 # StateForecastReporting
DEM.S.F03=0 # StartTimeAdjustment
DEM.S.F04=0 # Pausable
DEM.S.F05=0 # ForecastAdjustment
DEM.S.F06=0 # ConstraintBasedAdjustment
DEM.S.A0000=1 # ESAType
DEM.S.A0001=1 # ESACanGenerate
DEM.S.A0002=1 # ESAState
DEM.S.A0003=1 # AbsMinPower
DEM.S.A0004=1 # AbsMaxPower
DEM.S.A0005=1 # PowerAdjustmentCapability
DEM.S.A0006=1 # Forecast
DEM.S.A0007=1 # OptOutState
DEM.S.C00.Rsp=1 # PowerAdjustRequest
DEM.S.C01.Rsp=1 # CancelPowerAdjustRequest
DEM.S.C02.Rsp=0 # StartTimeAdjustRequest
DEM.S.C03.Rsp=0 # PauseRequest
DEM.S.C04.Rsp=0 # ResumeRequest
DEM.S.C05.Rsp=0 # ModifyForecastRequest
DEM.S.C06.Rsp=0 # RequestConstraintBasedForecast
DEM.S.C07.Rsp=0 # CancelRequest
DEM.S.E00=0 # PowerAdjustStart
DEM.S.E01=0 # PowerAdjustEnd
DEM.S.E02=0 # Paused
DEM.S.E03=0 # Resumed
DEM.S.M.ManuallyControlledOptOut=0

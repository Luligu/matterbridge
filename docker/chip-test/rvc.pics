# To run tests on the RVC Run Mode, RVC Clean Mode, RVC Operational State, and Service Area clusters --PICS is required
# Matches RoboticVacuumCleaner/MatterbridgeRvcRunModeServer/MatterbridgeRvcCleanModeServer/
# MatterbridgeRvcOperationalStateServer/MatterbridgeServiceAreaServer on endpoint 1201.
PICS_SDK_CI_ONLY=1

RVCRUNM.S=1
RVCRUNM.C=0
RVCRUNM.S.A0000=1 # SupportedModes
RVCRUNM.S.A0001=1 # CurrentMode
RVCRUNM.S.C00.Rsp=1 # ChangeToMode
RVCRUNM.S.C01.Tx=1 # ChangeToModeResponse
RVCRUNM.S.M.CAN_MANUALLY_CONTROLLED=1
RVCRUNM.S.M.CAN_TEST_MODE_FAILURE=1

RVCCLEANM.S=1
RVCCLEANM.C=0
RVCCLEANM.S.A0000=1 # SupportedModes
RVCCLEANM.S.A0001=1 # CurrentMode
RVCCLEANM.S.C00.Rsp=1 # ChangeToMode
RVCCLEANM.S.C01.Tx=1 # ChangeToModeResponse
RVCCLEANM.S.M.CAN_MANUALLY_CONTROLLED=1
RVCCLEANM.S.M.CAN_TEST_MODE_FAILURE=1

RVCOPSTATE.S=1
RVCOPSTATE.C=0
RVCOPSTATE.S.M.CAN_MANUALLY_CONTROLLED=1
RVCOPSTATE.S.M.RESUME_AFTER_ERR=0
RVCOPSTATE.S.M.ST_STOPPED=1
RVCOPSTATE.S.M.ST_RUNNING=1
RVCOPSTATE.S.M.ST_PAUSED=1
RVCOPSTATE.S.M.ST_ERROR=1
RVCOPSTATE.S.M.ST_SEEKING_CHARGER=1
RVCOPSTATE.S.M.ST_CHARGING=1
RVCOPSTATE.S.M.ST_DOCKED=1
RVCOPSTATE.S.M.ST_EMPTYINGDUSTBIN=0
RVCOPSTATE.S.M.ST_CLEANINGMOP=0
RVCOPSTATE.S.M.ST_FILLINGWATERTNK=0
RVCOPSTATE.S.M.ST_UPDATINGMAPS=0
RVCOPSTATE.S.M.ERR_NO_ERROR=1
RVCOPSTATE.S.M.ERR_UNABLE_TO_START_OR_RESUME=1
RVCOPSTATE.S.M.ERR_UNABLE_TO_COMPLETE_OPERATION=1
RVCOPSTATE.S.M.ERR_COMMAND_INVALID_IN_STATE=1
RVCOPSTATE.S.M.ERR_FAILED_TO_FIND_CHARGING_DOCK=1
RVCOPSTATE.S.M.ERR_STUCK=1
RVCOPSTATE.S.M.ERR_DUST_BIN_MISSING=1
RVCOPSTATE.S.M.ERR_DUST_BIN_FULL=1
RVCOPSTATE.S.M.ERR_WATER_TANK_EMPTY=1
RVCOPSTATE.S.M.ERR_WATER_TANK_MISSING=1
RVCOPSTATE.S.M.ERR_WATER_TANK_LID_OPEN=1
RVCOPSTATE.S.M.ERR_MOP_CLEANING_PAD_MISSING=1
RVCOPSTATE.S.M.ERR_BATTERY_LOW=1
RVCOPSTATE.S.M.ERR_CANTREACHTGT=1
RVCOPSTATE.S.M.ERR_DIRTYWATERFULL=1
RVCOPSTATE.S.M.ERR_DIRTYWATERMISS=1
RVCOPSTATE.S.M.ERR_WHEELSJAMMED=1
RVCOPSTATE.S.M.ERR_BRUSHJAMMED=1
RVCOPSTATE.S.M.NAVSENSOBSCUR=1
RVCOPSTATE.S.A0000=1 # PhaseList
RVCOPSTATE.S.A0001=1 # CurrentPhase
RVCOPSTATE.S.A0002=1 # CountdownTime
RVCOPSTATE.S.A0003=1 # OperationalStateList
RVCOPSTATE.S.A0004=1 # OperationalState
RVCOPSTATE.S.A0005=1 # OperationalError
RVCOPSTATE.S.C00.Rsp=1 # Pause
RVCOPSTATE.S.C03.Rsp=1 # Resume
RVCOPSTATE.S.C04.Tx=1 # OperationalCommandResponse
RVCOPSTATE.S.C80.Rsp=1 # GoHome

SEAR.S=1
SEAR.C=0
SEAR.S.F00=0 # SelectWhileRunning
SEAR.S.F01=0 # ProgressReporting
SEAR.S.F02=1 # Maps
SEAR.S.A0000=1 # SupportedAreas
SEAR.S.A0001=1 # SupportedMaps
SEAR.S.A0002=1 # SelectedAreas
SEAR.S.A0003=1 # CurrentArea
SEAR.S.A0004=1 # EstimatedEndTime
SEAR.S.A0005=0 # Progress
SEAR.S.C00.Rsp=1 # SelectAreas
SEAR.S.C01.Tx=1 # SelectAreasResponse
SEAR.S.C02.Rsp=0 # SkipArea
SEAR.S.C03.Tx=0 # SkipAreaResponse
SEAR.S.M.REMOVE_MAP=0
SEAR.S.M.ADD_MAP=0
SEAR.S.M.REMOVE_AREA=0
SEAR.S.M.ADD_AREA=0

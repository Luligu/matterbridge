# To run tests on SmokeCOAlarm --PICS is required
# Matches createCoOnlySmokeCOAlarmClusterServer() on CHIP SmokeCOAlarm endpoint 7092
PICS_USER_PROMPT=0
PICS_SKIP_SAMPLE_APP=1
SMOKECO.S=1
SMOKECO.S.F00=0 # SmokeAlarm
SMOKECO.S.F01=1 # CoAlarm
SMOKECO.S.A0000=1 # ExpressedState
SMOKECO.S.A0001=0 # SmokeState
SMOKECO.S.A0002=1 # COState
SMOKECO.S.A0003=1 # BatteryAlert
SMOKECO.S.A0004=1 # DeviceMuted
SMOKECO.S.A0005=1 # TestInProgress
SMOKECO.S.A0006=1 # HardwareFaultAlert
SMOKECO.S.A0007=1 # EndOfServiceAlert
SMOKECO.S.A0008=0 # InterconnectSmokeAlarm
SMOKECO.S.A0009=0 # InterconnectCOAlarm
SMOKECO.S.A000a=0 # ContaminationState
SMOKECO.S.A000b=0 # SmokeSensitivityLevel
SMOKECO.S.A000c=0 # ExpiryDate
SMOKECO.S.A000d=0 # Unmounted
SMOKECO.S.E00=0 # SmokeAlarm
SMOKECO.S.E01=1 # COAlarm
SMOKECO.S.E02=1 # LowBattery
SMOKECO.S.E03=1 # HardwareFault
SMOKECO.S.E04=1 # EndOfService
SMOKECO.S.E05=1 # SelfTestComplete
SMOKECO.S.E06=1 # AlarmMuted
SMOKECO.S.E07=1 # MuteEnded
SMOKECO.S.E08=0 # InterconnectSmokeAlarm
SMOKECO.S.E09=0 # InterconnectCOAlarm
SMOKECO.S.E0a=1 # AllClear
SMOKECO.S.C00.Rsp=1 # SelfTestRequest
SMOKECO.M.ManuallyControlledTest=0
SMOKECO.M.ManuallyControlledMute=0
SMOKECO.M.InoperativeWhenUnmounted=0

# To run tests on PumpConfigurationAndControl --PICS is required
# Matches createDefaultPumpConfigurationAndControlClusterServer() (via addRequiredClusters()) on CHIP Pump
# endpoint 505 (ConstantSpeed feature only).
PICS_USER_PROMPT=0
PICS_SKIP_SAMPLE_APP=1
PCC.S=1
PCC.S.F00=0 # ConstantPressure
PCC.S.F01=0 # CompensatedPressure
PCC.S.F02=0 # ConstantFlow
PCC.S.F03=1 # ConstantSpeed
PCC.S.F04=0 # ConstantTemperature
PCC.S.F05=0 # Automatic
PCC.S.F06=0 # LocalOperation
PCC.S.A0000=1 # MaxPressure
PCC.S.A0001=1 # MaxSpeed
PCC.S.A0002=1 # MaxFlow
PCC.S.A0003=0 # MinConstPressure (ConstantPressure not supported)
PCC.S.A0004=0 # MaxConstPressure (ConstantPressure not supported)
PCC.S.A0005=0 # MinCompPressure (CompensatedPressure not supported)
PCC.S.A0006=0 # MaxCompPressure (CompensatedPressure not supported)
PCC.S.A0007=1 # MinConstSpeed
PCC.S.A0008=1 # MaxConstSpeed
PCC.S.A0009=0 # MinConstFlow (ConstantFlow not supported)
PCC.S.A000a=0 # MaxConstFlow (ConstantFlow not supported)
PCC.S.A000b=0 # MinConstTemp (ConstantTemperature not supported)
PCC.S.A000c=0 # MaxConstTemp (ConstantTemperature not supported)
PCC.S.A0010=0 # PumpStatus (optional, not implemented)
PCC.S.A0011=1 # EffectiveOperationMode
PCC.S.A0012=1 # EffectiveControlMode
PCC.S.A0013=1 # Capacity
PCC.S.A0014=0 # Speed (optional, not implemented)
PCC.S.A0015=0 # LifetimeRunningHours (optional, not implemented)
PCC.S.A0016=0 # Power (optional, not implemented)
PCC.S.A0017=0 # LifetimeEnergyConsumed (optional, not implemented)
PCC.S.A0020=1 # OperationMode
PCC.S.A0021=0 # ControlMode (not conformant: requires PRSCONST | PRSCOMP | FLW | TEMP, none of which are supported)
PCC.S.A0022=0 # AlarmMask (optional, not implemented)
PCC.S.E00=0 # SupplyVoltageLow (not implemented)
PCC.S.E01=0 # SupplyVoltageHigh (not implemented)
PCC.S.E02=0 # PowerMissingPhase (not implemented)
PCC.S.E03=0 # SystemPressureLow (not implemented)
PCC.S.E04=0 # SystemPressureHigh (not implemented)
PCC.S.E05=0 # DryRunning (not implemented)
PCC.S.E06=0 # MotorTemperatureHigh (not implemented)
PCC.S.E07=0 # PumpMotorFatalFailure (not implemented)
PCC.S.E08=0 # ElectronicTemperatureHigh (not implemented)
PCC.S.E09=0 # PumpBlocked (not implemented)
PCC.S.E0a=0 # SensorFailure (not implemented)
PCC.S.E0b=0 # ElectronicNonFatalFailure (not implemented)
PCC.S.E0c=0 # ElectronicFatalFailure (not implemented)
PCC.S.E0d=0 # GeneralFault (not implemented)
PCC.S.E0e=0 # Leakage (not implemented)
PCC.S.E0f=0 # AirDetection (not implemented)
PCC.S.E10=0 # TurbineOperation (not implemented)
PCC.C=0 # Matterbridge only exposes a PumpConfigurationAndControl server, never acts as a client

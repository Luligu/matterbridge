# PTZ Camera endpoint 16011: Camera and MatterbridgeCameraAvSettingsUserLevelManagementServer.
# These are the PICS gates consumed by the AVSUM Python tests; other capabilities
# are checked against the live FeatureMap and AttributeList.
PICS_SDK_CI_ONLY=1
AVSUM.S=1
AVSUM.C=0
AVSUM.S.F00=1 # DigitalPTZ
AVSUM.S.F01=1 # MechanicalPan
AVSUM.S.F02=1 # MechanicalTilt
AVSUM.S.F03=1 # MechanicalZoom
AVSUM.S.F04=1 # MechanicalPresets
AVSM.S=1

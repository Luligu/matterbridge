# To run tests on the Oven Mode and Oven Cavity Operational State clusters --PICS is required
# Matches the top Oven Cabinet endpoint 13091; endpoint 13092 has the same cluster configuration.
PICS_SDK_CI_ONLY=1
PICS_USER_PROMPT=0
PICS_SKIP_SAMPLE_APP=1

OTCCM.S=1
OTCCM.S.A0000=1 # SupportedModes
OTCCM.S.A0001=1 # CurrentMode
OTCCM.S.C00.Rsp=1 # ChangeToMode
OTCCM.S.C01.Tx=1 # ChangeToModeResponse
OTCCM.S.M.CAN_TEST_MODE_FAILURE=0
OTCCM.S.M.CAN_MANUALLY_CONTROLLED=0

OVENOPSTATE.S=1
OVENOPSTATE.C=0
OVENOPSTATE.S.M.ST_STOPPED=0
OVENOPSTATE.S.M.ST_RUNNING=0
OVENOPSTATE.S.M.ST_ERROR=0
OVENOPSTATE.S.M.ERR_NO_ERROR=0
OVENOPSTATE.S.M.ERR_UNABLE_TO_START_OR_RESUME=0
OVENOPSTATE.S.M.ERR_UNABLE_TO_COMPLETE_OPERATION=0
OVENOPSTATE.S.M.ERR_COMMAND_INVALID_IN_STATE=0
OVENOPSTATE.S.A0000=1 # PhaseList
OVENOPSTATE.S.A0001=1 # CurrentPhase
OVENOPSTATE.S.A0002=0 # CountdownTime
OVENOPSTATE.S.A0003=1 # OperationalStateList
OVENOPSTATE.S.A0004=1 # OperationalState
OVENOPSTATE.S.A0005=1 # OperationalError
OVENOPSTATE.S.C01.Rsp=1 # Stop
OVENOPSTATE.S.C02.Rsp=1 # Start
OVENOPSTATE.S.C04.Tx=1 # OperationalCommandResponse
OVENOPSTATE.S.E00=1 # OperationalError
OVENOPSTATE.S.E01=1 # OperationCompletion

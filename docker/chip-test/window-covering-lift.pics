# To run tests on WindowCovering --PICS is required
# Matches the WindowCovering server on CHIP WindowCoveringLift endpoint 803: Lift and
# PositionAwareLift features only (createDefaultWindowCoveringClusterServer()).
# See window-covering-tilt.pics (endpoint 8031) and window-covering-lift-tilt.pics
# (endpoint 8032) for the Tilt-only and combined Lift+Tilt device variants.
PICS_SDK_CI_ONLY=1
WNCV.S=1
WNCV.S.F00=1 # Lift
WNCV.S.F02=1 # PositionAwareLift
WNCV.S.A0000=1 # Type
WNCV.S.A0005=1 # NumberOfActuationsLift
WNCV.S.A0007=1 # ConfigStatus
WNCV.S.A000A=1 # OperationalStatus
WNCV.S.A000B=1 # TargetPositionLiftPercent100ths
WNCV.S.A000D=1 # EndProductType
WNCV.S.A000E=1 # CurrentPositionLiftPercent100ths
WNCV.S.A0017=1 # Mode
WNCV.S.C00.Rsp=1 # UpOrOpen
WNCV.S.C01.Rsp=1 # DownOrClose
WNCV.S.C02.Rsp=1 # StopMotion
WNCV.S.C05.Rsp=1 # GoToLiftPercentage

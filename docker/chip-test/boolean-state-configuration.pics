BOOLCFG.S.F01=1 # Audible
BOOLCFG.S.F02=1 # AlarmSuppress
BOOLCFG.S.F03=1 # SensitivityLevel
BOOLCFG.S.F04=1 # FaultEvents
BOOLCFG.S.A0000=1 # CurrentSensitivityLevel
BOOLCFG.S.A0001=1 # SupportedSensitivityLevels
BOOLCFG.S.A0002=1 # DefaultSensitivityLevel
BOOLCFG.S.A0003=1 # AlarmsActive
BOOLCFG.S.A0004=1 # AlarmsSuppressed
BOOLCFG.S.A0005=1 # AlarmsEnabled
BOOLCFG.S.A0006=1 # AlarmsSupported
BOOLCFG.S.A0007=1 # SensorFault
BOOLCFG.S.E00=1 # AlarmsStateChanged
BOOLCFG.S.E01=1 # SensorFault
BOOLCFG.S.C00.Rsp=1 # SuppressAlarm
BOOLCFG.S.C01.Rsp=1 # EnableDisableAlarm

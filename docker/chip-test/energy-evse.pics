EEVSE.S.F01=1 # ChargingPreferences
EEVSE.S.F02=0 # SoCReporting
EEVSE.S.F03=0 # PlugAndCharge
EEVSE.S.F04=0 # RFID
EEVSE.S.A0000=1 # State
EEVSE.S.A0001=1 # SupplyState
EEVSE.S.A0002=1 # FaultState
EEVSE.S.A0003=1 # ChargingEnabledUntil
EEVSE.S.A0004=0 # DischargingEnabledUntil
EEVSE.S.A0005=1 # CircuitCapacity
EEVSE.S.A0006=1 # MinimumChargeCurrent
EEVSE.S.A0007=1 # MaximumChargeCurrent
EEVSE.S.A0008=0 # MaximumDischargeCurrent
EEVSE.S.A0009=1 # UserMaximumChargeCurrent
EEVSE.S.A000A=0 # RandomizationDelayWindow
EEVSE.S.A0023=1 # NextChargeStartTime
EEVSE.S.A0024=1 # NextChargeTargetTime
EEVSE.S.A0025=1 # NextChargeRequiredEnergy
EEVSE.S.A0026=1 # NextChargeTargetSoC
EEVSE.S.A0027=0 # ApproximateEVEfficiency
EEVSE.S.A0030=0 # StateOfCharge
EEVSE.S.A0031=0 # BatteryCapacity
EEVSE.S.A0032=0 # VehicleID
EEVSE.S.A0040=1 # SessionID
EEVSE.S.A0041=1 # SessionDuration
EEVSE.S.A0042=1 # SessionEnergyCharged
EEVSE.S.A0043=0 # SessionEnergyDischarged
EEVSE.S.C00.Rsp=1 # Disable
EEVSE.S.C01.Rsp=0 # EnableDischarging
EEVSE.S.C02.Rsp=1 # EnableCharging
EEVSE.S.C03.Rsp=1 # SetTargets
EEVSE.S.C04.Rsp=1 # GetTargets
EEVSE.S.C05.Tx=1 # GetTargetsResponse
EEVSE.S.C06.Rsp=1 # ClearTargets
EEVSE.S.C07.Rsp=1 # StartDiagnostics
EEVSE.S.E00=1 # EVConnected
EEVSE.S.E01=1 # EVNotDetected
EEVSE.S.E02=1 # EnergyTransferStarted
EEVSE.S.E03=1 # EnergyTransferStopped
EEVSE.S.E04=1 # Fault

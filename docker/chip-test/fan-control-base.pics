# To run tests on FanControl --PICS is required
# Matches createBaseFanControlClusterServer() (no optional features, OffLowMedHigh) on CHIP Extractor Hood endpoint 1310
PICS_SDK_CI_ONLY=1
FAN.S=1
FAN.S.F00=0 # MultiSpeed
FAN.S.F01=0 # Auto
FAN.S.F02=0 # Rocking
FAN.S.F03=0 # Wind
FAN.S.F04=0 # Step
FAN.S.F05=0 # AirflowDirection
FAN.S.A0000=1 # FanMode
FAN.S.A0001=1 # FanModeSequence
FAN.S.A0002=1 # PercentSetting
FAN.S.A0003=1 # PercentCurrent
FAN.S.A0004=0 # SpeedMax
FAN.S.A0005=0 # SpeedSetting
FAN.S.A0006=0 # SpeedCurrent
FAN.S.A0007=0 # RockSupport
FAN.S.A0008=0 # RockSetting
FAN.S.A0009=0 # WindSupport
FAN.S.A000a=0 # WindSetting
FAN.S.A000b=0 # AirflowDirection
FAN.S.C00.Rsp=0 # Step

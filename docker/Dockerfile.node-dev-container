# docker/Dockerfile.node-dev-container v.2.1.1

# This Dockerfile is used to build a development container for Node.js applications.
# It is based on the official Node.js Docker image and includes additional tools and configurations for a better development experience.
# Bash history is configured to be synced across terminals.

FROM node:24-trixie-slim

ENV HISTFILE=/home/node/.bash-cache/.bash_history
ENV HISTSIZE=100000
ENV HISTFILESIZE=200000

# ---- Build arguments injected by CI ----
ARG VERSION
ARG VCS_REF
ARG BUILD_DATE

# ---- OCI standard labels (https://opencontainers.org/) ----
LABEL org.opencontainers.image.title="matterbridge:node-dev-container" \
  org.opencontainers.image.description="Matterbridge Node.js Dev Container" \
  org.opencontainers.image.version=$VERSION \
  org.opencontainers.image.revision=$VCS_REF \
  org.opencontainers.image.source="git+https://github.com/Luligu/matterbridge.git" \
  org.opencontainers.image.url="https://matterbridge.io" \
  org.opencontainers.image.documentation="https://matterbridge.io/README.html" \
  org.opencontainers.image.licenses="Apache-2.0" \
  org.opencontainers.image.authors="Luligu <https://github.com/Luligu>" \
  org.opencontainers.image.created=$BUILD_DATE

RUN apt-get update \
  && apt-get install --yes --no-install-recommends avahi-utils bubblewrap btop ca-certificates curl dnsutils fd-find fzf git iproute2 iputils-ping jq nano openssh-client procps ripgrep shellcheck shfmt sudo unzip \
  && ln -s /usr/bin/fdfind /usr/local/bin/fd \
  && mkdir -p /home/node/.bash-cache \
    /home/node/.vscode-server/extensions \
    /home/node/Matterbridge \
    /home/node/.matterbridge \
    /home/node/.mattercert \
    /home/node/.claude \
    /home/node/.codex \
    /home/node/.gemini \
    /home/node/.agents \
    /home/node/.npm \
    /home/node/.bun/install/cache \
  && sed -i '/^HISTSIZE=/d; /^HISTFILESIZE=/d' /home/node/.bashrc \
  && { \
    echo ''; \
    echo '# Keep Bash history synced across terminals.'; \
    echo 'shopt -s histappend'; \
    echo '__sync_history() {'; \
    echo '  history -a'; \
    echo '  history -n'; \
    echo '}'; \
    echo 'PROMPT_COMMAND="__sync_history${PROMPT_COMMAND:+;$PROMPT_COMMAND}"'; \
  } >> /home/node/.bashrc \
  && chown -R node:node /home/node \
  && echo "node ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/node \
  && chmod 0440 /etc/sudoers.d/node \
  && rm -rf /var/lib/apt/lists/*

# Copy Dev Container lifecycle scripts
COPY docker/devcontainer/*.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/install-matterbridge.sh /usr/local/bin/post-create.sh /usr/local/bin/post-start.sh

USER node
WORKDIR /home/node

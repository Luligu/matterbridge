{
  "name": "@matterbridge/test-utils",
  "version": "3.10.14",
  "description": "Matterbridge common and framework-specific test utilities",
  "author": "https://github.com/Luligu",
  "homepage": "https://matterbridge.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luligu/matterbridge.git",
    "directory": "packages/test-utils"
  },
  "bugs": {
    "url": "https://github.com/Luligu/matterbridge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "matterbridge",
    "homebridge",
    "bridge",
    "plugin",
    "frontend",
    "matter.js",
    "matter-node.js",
    "matter",
    "matterprotocol",
    "iot",
    "smarthome",
    "connectedthings",
    "hap",
    "homekit",
    "siri",
    "google-home",
    "alexa",
    "homeassistant",
    "smartthings",
    "ewelink"
  ],
  "license": "Apache-2.0",
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/luligugithub"
  },
  "type": "module",
  "main": "./dist/export.js",
  "types": "./dist/export.d.ts",
  "exports": {
    ".": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./matter": {
      "types": "./dist/matter/export.d.ts",
      "import": "./dist/matter/export.js"
    },
    "./jest": {
      "types": "./dist/jest/export.d.ts",
      "import": "./dist/jest/export.js"
    },
    "./jest/setup": {
      "types": "./dist/jest/setupTest.d.ts",
      "import": "./dist/jest/setupTest.js"
    },
    "./jest/matter": {
      "types": "./dist/jest/matterTest.d.ts",
      "import": "./dist/jest/matterTest.js"
    },
    "./vitest": {
      "types": "./dist/vitest/export.d.ts",
      "import": "./dist/vitest/export.js"
    },
    "./vitest/setup": {
      "types": "./dist/vitest/setupTest.d.ts",
      "import": "./dist/vitest/setupTest.js"
    },
    "./vitest/matter": {
      "types": "./dist/vitest/matterTest.d.ts",
      "import": "./dist/vitest/matterTest.js"
    },
    "./buntest": {
      "types": "./dist/buntest/export.d.ts",
      "import": "./dist/buntest/export.js"
    },
    "./buntest/setup": {
      "types": "./dist/buntest/setupTest.d.ts",
      "import": "./dist/buntest/setupTest.js"
    },
    "./buntest/matter": {
      "types": "./dist/buntest/matterTest.d.ts",
      "import": "./dist/buntest/matterTest.js"
    }
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0 || >=22.13.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "files": [
    "bin",
    "dist",
    "npm-shrinkwrap.json",
    "CHANGELOG.md"
  ],
  "automator": {
    "node": true,
    "vitestTypes": true,
    "skipPackageJson": true,
    "skipTsconfig": true
  },
  "dependencies": {
    "@matter/main": "0.17.9",
    "@matterbridge/types": "3.10.14",
    "node-ansi-logger": "3.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.4",
    "vitest": "5.0.3"
  }
}

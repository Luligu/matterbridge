    },
    "./unicast": {
      "types": "./dist/unicast.d.ts",
      "import": "./dist/unicast.js"
    }
  },
  "engines": {
    "node": ">=22.13.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "files": [
    "bin",
    "dist",
    "npm-shrinkwrap.json",
    "CHANGELOG.md"
  ],
  "automator": {
    "node": true,
    "vitest": true,
    "skipPackageJson": true,
    "skipTsconfig": true

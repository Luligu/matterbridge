    "./matterbridge-advertise": {
      "types": "./dist/matterbridgeAdvertise.d.ts",
      "import": "./dist/matterbridgeAdvertise.js"
    },
    "./matter-advertise": {
      "types": "./dist/matterAdvertise.d.ts",
      "import": "./dist/matterAdvertise.js"
    },
    "./mdns-responder": {
      "types": "./dist/mdnsResponder.d.ts",
      "import": "./dist/mdnsResponder.js"
    },
    "./mdns-resolver": {
      "types": "./dist/mdnsResolver.d.ts",
      "import": "./dist/mdnsResolver.js"
    },
    "./mdns-monitor": {
      "types": "./dist/mdnsMonitor.d.ts",
      "import": "./dist/mdnsMonitor.js"
    },
    "./mdns-scanner": {
      "types": "./dist/mdnsScanner.d.ts",
      "import": "./dist/mdnsScanner.js"
    },
    "./multicast": {
      "types": "./dist/multicast.d.ts",
